      "category": 6,
      "jobs": [
        "runtime-parity-perf-gate"
      ],
      "needs": [
        "python-tests"
      ],
      "condition": null,
      "permissions": {
        "contents": "read"
      },
      "secrets": {},
      "workflow_call": {}
    },
    "rust-tests": {
