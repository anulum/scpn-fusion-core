# SCPN Fusion Core — PROCESS adapter branch coverage
[run]
branch = True
parallel = True
patch = subprocess
source = validation

[report]
include =
    */validation/process_power_report.py
    */validation/process_reference_run.py
show_missing = True
fail_under = 100
